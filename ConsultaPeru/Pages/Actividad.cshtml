@page
@model ActividadModel
@using ConsultaPeru.Actividad
@{ ViewData["Title"] = "Actividad del sitio"; }
<form method="post" asp-page-handler="Salir" class="logout-form"><button type="submit">Cerrar acceso privado</button></form>
<section class="intro"><span class="eyebrow">ADMINISTRACIÓN PRIVADA</span><h1>Actividad <em>del sitio.</em></h1><p>Registro acumulado desde la activación. Las horas se muestran en Perú.</p></section>
@if (Model.ErrorLectura is not null) { <div class="error" role="alert">@Model.ErrorLectura</div> }
@if (!Model.Salud.Disponible) { <div class="error" role="alert">Se detectaron @Model.Salud.FallosEscritura fallos de escritura en esta ejecución. Algunos eventos podrían no estar registrados. Revisa los permisos y el espacio disponible.</div> }
<div class="metrics">
<div class="card"><span>Cargas de páginas</span><strong>@Model.Visitas</strong></div>
<div class="card"><span>Búsquedas enviadas</span><strong>@Model.Busquedas</strong></div>
<div class="card"><span>Con resultados</span><strong>@Model.ConResultados</strong></div>
<div class="card"><span>Sin información disponible</span><strong>@Model.SinResultados</strong></div>
<div class="card"><span>Incidencias</span><strong>@Model.Incidencias</strong></div>
</div>
<p class="hint">Una visita es una carga GET de DNI/RUC o tipo de cambio; recargar cuenta otra vez. No identifica personas únicas ni distingue bots. Un POST cuenta como búsqueda, incluso si falla la validación. Las respuestas restringidas se cuentan aparte. El panel y los archivos estáticos no suman visitas. Los intentos de API se registran por separado: usar respaldo no duplica la búsqueda.</p>
<section class="card"><h2>Búsquedas por tipo y resultado</h2><div class="table-wrap"><table><thead><tr><th>Operación</th><th>Resultado</th><th>Cantidad</th></tr></thead><tbody>
@foreach (var grupo in Model.Eventos.Where(e => e.Tipo == TipoEvento.Busqueda).GroupBy(e => new { e.Operacion, e.Estado }).OrderBy(g => g.Key.Operacion).ThenBy(g => g.Key.Estado)) {
<tr><td>@grupo.Key.Operacion</td><td>@grupo.Key.Estado</td><td>@grupo.Count()</td></tr>
}
</tbody></table></div></section>
<section class="card activity-history"><h2>Últimos 100 eventos</h2><div class="table-wrap"><table><thead><tr><th>Fecha (Perú)</th><th>Tipo</th><th>Operación</th><th>Estado</th><th>Proveedor</th><th>HTTP</th><th>ms</th><th>Detalle</th><th>Solicitud</th></tr></thead><tbody>
@foreach (var e in Model.Eventos.Take(100)) {
<tr><td>@ActividadModel.HoraPeru(e.FechaUtc)</td><td>@e.Tipo</td><td>@e.Operacion</td><td>@e.Estado</td><td>@e.Proveedor</td><td>@e.CodigoHttp</td><td>@e.DuracionMs</td><td>@e.Detalle</td><td><code>@e.SolicitudId</code></td></tr>
}
</tbody></table></div></section><p class="hint">Persistencia: App_Data/Actividad/*.csv, fuera de wwwroot y excluida de Git y de publicación. No se almacenan documentos, nombres, fechas de nacimiento, IP ni claves. Guarda una copia de esta carpeta para conservar el historial.</p>
