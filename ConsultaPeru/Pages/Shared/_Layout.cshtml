<!DOCTYPE html>
<html lang="es-PE"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex,nofollow" /><title>@ViewData["Title"] · Dato al Toque</title>
<link rel="icon" type="image/svg+xml" href="~/datoaltoque.svg" asp-append-version="true" />
<meta name="theme-color" content="#087c69" /><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head>
<body><header><a class="brand" asp-page="/Index"><img class="brand-icon" src="~/datoaltoque.svg" asp-append-version="true" width="44" height="44" alt="" aria-hidden="true" /> Dato al <span>Toque</span></a><nav aria-label="Navegación principal"><a asp-page="/Index">DNI / RUC</a><a asp-page="/TipoCambio">Tipo de cambio</a></nav></header><main>@RenderBody()</main><footer><span>Dato al Toque © @DateTime.Now.Year</span><span>Servicio independiente · No afiliado a RENIEC ni SUNAT</span></footer><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required: false)</body></html>
