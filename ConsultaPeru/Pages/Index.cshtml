@page
@model IndexModel
@{ ViewData["Title"] = "Consulta de DNI y RUC"; }
<section class="intro"><span class="eyebrow">CONSULTAS DE DOCUMENTOS · PERÚ</span><h1>La información que necesitas,<br /><em>en una consulta.</em></h1><p>Busca nombres por DNI o los datos de un contribuyente por RUC.</p></section>
<section class="workspace" id="consulta-area" data-has-result="@(Model.Resultado is not null ? "true" : "false")">
<div class="card"><div class="heading"><span class="step">01</span><div><h2>Consulta un documento</h2><p>Selecciona el tipo e ingresa el número.</p></div></div>
<form method="post" id="consulta-form"><fieldset><legend class="sr-only">Tipo de documento</legend><label><input type="radio" asp-for="Tipo" id="tipo-dni" value="DNI" /><span><strong>DNI</strong><small>Persona natural</small></span></label><label><input type="radio" asp-for="Tipo" id="tipo-ruc" value="RUC" /><span><strong>RUC</strong><small>Contribuyente</small></span></label></fieldset>
<label class="input-label" for="Numero">Número de documento</label><div class="number-input"><input asp-for="Numero" inputmode="numeric" autocomplete="off" maxlength="@(Model.Tipo == "RUC" ? 11 : 8)" pattern="@(Model.Tipo == "RUC" ? "[0-9]{11}" : "[0-9]{8}")" placeholder="@(Model.Tipo == "RUC" ? "Ingresa los 11 dígitos" : "Ingresa los 8 dígitos")" required aria-describedby="ayuda" /><button type="button" id="limpiar-numero" class="clear-number" aria-label="Borrar número de documento" title="Borrar número" hidden="@(string.IsNullOrEmpty(Model.Numero))"><span aria-hidden="true">×</span></button></div><p id="ayuda" class="hint">@(Model.Tipo == "RUC" ? "11" : "8") dígitos, sin espacios ni guiones.</p><button type="submit">Buscar documento <span aria-hidden="true">→</span></button><partial name="_EnlacesLegales" /><p class="note">Consulta únicamente para una finalidad legítima.</p></form></div>
<div class="card" id="consulta-resultado" data-result-panel aria-live="polite"><div class="heading"><span class="step">02</span><div><h2>Resultado de la consulta</h2><p>Datos proporcionados por el servicio externo.</p></div></div>
@if (Model.Error is not null) { <div class="error" role="alert"><strong>No pudimos completar la consulta</strong><p>@Model.Error</p></div> }
else if (Model.Resultado is { } r) {
<dl class="result-fields">
<partial name="_CampoResultado" model='new ConsultaPeru.Services.CampoResultado(Model.Tipo, r.Numero)' />
<partial name="_CampoResultado" model='new ConsultaPeru.Services.CampoResultado(Model.Tipo == "DNI" ? "Nombre completo" : "Razón social", r.Nombre)' />
@if (Model.Tipo == "DNI") {
<partial name="_CampoResultado" model='new ConsultaPeru.Services.CampoResultado("Nombres", r.Nombres)' />
<partial name="_CampoResultado" model='new ConsultaPeru.Services.CampoResultado("Apellido paterno", r.Paterno)' />
<partial name="_CampoResultado" model='new ConsultaPeru.Services.CampoResultado("Apellido materno", r.Materno)' />
} else {
<partial name="_CampoResultado" model='new ConsultaPeru.Services.CampoResultado("Dirección", r.Direccion)' />
<partial name="_CampoResultado" model='new ConsultaPeru.Services.CampoResultado("Estado", r.Estado)' />
<partial name="_CampoResultado" model='new ConsultaPeru.Services.CampoResultado("Condición", r.Condicion)' />
@foreach (var campo in r.Adicionales) { <partial name="_CampoResultado" model="campo" /> }
}
</dl>
} else { <div class="empty"><span class="document-icon" aria-hidden="true">▤</span><h3>Tu consulta empieza aquí</h3><p>Ingresa un documento y sus datos<br />aparecerán en este espacio.</p><small>DNI · 8 dígitos &nbsp; / &nbsp; RUC · 11 dígitos</small></div> }
</div></section><aside><span aria-hidden="true">ⓘ</span><p><strong>Información al momento de consultar.</strong> La disponibilidad y actualización dependen del proveedor. Esta versión no guarda los documentos consultados en una base de datos.</p></aside>
<p id="copy-status" role="status" class="hint"></p>
